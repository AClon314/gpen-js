{
  "name": "gpen-js",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    "./storage": "./src/lib/bindings/storage/index.ts",
    "./upDownloader": "./src/lib/bindings/upDownloader/index.ts",
    "./storage/vscode": "./src/lib/bindings/storage/vscode.ts"
  },
  "scripts": {
    "//dev": "优先用.env而非已有的环境变量, --host则允许局域网访问本网页",
    "dev": "set -a; . .env; set +a; vite dev --host",
    "build": "vite build",
    "test": "bun test tests/*.test.ts",
    "test:e2e": "set -a; . .env 2>/dev/null || true; set +a; playwright test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bun run typecheck && oxlint .",
    "lint:staged": "lint-staged",
    "lint:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "check:commit": "commitlint --edit",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && husky"
  },
  "dependencies": {
    "penpal": "^8.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@inlang/paraglide-js": "^2.18.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "next",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.2.0",
    "bun-types": "^1.4.0",
    "fake-indexeddb": "^6.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,svelte}": [
      "oxfmt --write",
      "oxlint"
    ],
    "*.{json,jsonc,css,md}": "oxfmt --write"
  }
}
