{
  "name": "gpen-js",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    "./storage": {
      "types": "./src/lib/bindings/storage/index.ts",
      "default": "./src/lib/bindings/storage/index.ts"
    },
    "./upDownloader": {
      "types": "./src/lib/bindings/upDownloader/index.ts",
      "default": "./src/lib/bindings/upDownloader/index.ts"
    },
    "./storage/vscode": {
      "types": "./src/lib/bindings/storage/targets/vscode.ts",
      "default": "./src/lib/bindings/storage/targets/vscode.ts"
    },
    "./embed": {
      "types": "./src/embed/index.ts",
      "default": "./dist/embed/gpen-embed.js"
    }
  },
  "scripts": {
    "//dev": "优先用.env而非已有的环境变量, --host则允许局域网访问本网页",
    "dev": "set -a; . .env; set +a; vite dev --host",
    "build": "vite build",
    "test": "bun test tests/*.test.ts",
    "test:coverage": "bun test tests/*.test.ts --coverage --coverage-reporter=lcov && bun scripts/filter-lcov.ts",
    "health": "bun run health:gate",
    "health:gate": "bun scripts/health-gate.ts",
    "graph:func:call": "node rules/graph-func.mjs",
    "graph:module:deps": "bun rules/depcruise/graph.mjs deps",
    "graph:module:focus": "bun rules/depcruise/graph.mjs focus",
    "graph:module:overview": "bun rules/depcruise/graph.mjs overview",
    "graph:module:affected": "bun rules/depcruise/graph.mjs affected",
    "test:e2e": "set -a; . .env 2>/dev/null || true; set +a; playwright test --project=e2e",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bun run typecheck && oxlint && eslint && bun run lint:exports",
    "lint:exports": "bun scripts/order-exports.ts --check",
    "lint:staged": "lint-staged",
    "lint:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "check:commit": "commitlint --edit",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && husky",
    "build:embed": "vite build -c vite.embed.config.ts",
    "test:embed": "GPEN_EMBED_ONLY=1 playwright test --project=embed"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@spectrum-web-components/color-area": "^1.12.2",
    "@spectrum-web-components/color-field": "^1.12.2",
    "@spectrum-web-components/color-slider": "^1.12.2",
    "@spectrum-web-components/icons-workflow": "1.12.2",
    "@spectrum-web-components/swatch": "^1.12.2",
    "@spectrum-web-components/theme": "^1.12.2",
    "dockview": "^8.2.0",
    "flatbuffers": "25.9.23",
    "gpen-protocol": "file:../gpen-protocol",
    "moveable": "^0.53.0",
    "penpal": "^8.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@inlang/paraglide-js": "^2.18.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "next",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "bun-types": "^1.4.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,svelte}": [
      "oxlint"
    ],
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "oxfmt --write"
    ]
  }
}
