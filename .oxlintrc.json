{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "rules/jelly/**"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "jsPlugins": [
    "./rules/catch-must-return-or-throw.mts"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "catch/must-return-or-throw": "error",
    "catch/no-bare-return": "warn",
    "complexity": ["warn", 8],
    "max-depth": ["warn", 3],
    "max-lines-per-function": [
      "warn",
      { "max": 60, "skipBlankLines": true, "skipComments": true }
    ],
    "import/no-cycle": "error",
    "import/no-self-import": "error"
  },
  "overrides": [
    {
      "files": ["tests/**", "**/*.test.ts", "**/*.e2e.ts"],
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "max-lines-per-function": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}