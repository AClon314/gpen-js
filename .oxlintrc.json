{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "rules/jelly/**"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "jsPlugins": [
    "./rules/catch-must-return-or-throw.mts"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "catch/must-return-or-throw": "error",
    "catch/no-bare-return": "warn"
  },
  "env": {
    "builtin": true
  }
}